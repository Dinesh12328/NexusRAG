# Root .gitignore for NexusRAG Platform

# Dependencies & Build artifacts
node_modules/
dist/
target/
*.class
*.jar
*.war

# Environment variables & secrets
.env
.env.local
.env.*.local
*.PublishSettings

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / Coverage
coverage/
.nyc_output/
